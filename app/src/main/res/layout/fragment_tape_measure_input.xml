<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="30dp"
    android:gravity="center"
    android:background="@drawable/fragment_bg_315">

    <LinearLayout
        android:id="@+id/containerNeck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="@string/frag_tape_meas_input_label_1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="textEnd"
            android:textColor="@color/off_white"/>

        <EditText
            android:id="@+id/etNeck"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="30dp"
            android:layout_weight="1"
            android:background="@drawable/textview_box"
            android:gravity="center_vertical"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerWaist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/frag_tape_meas_input_label_2"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="textEnd"
            android:textColor="@color/off_white"/>

        <EditText
            android:id="@+id/etWaist"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/textview_box"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp"
            android:gravity="center_vertical"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerHips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="100dp" android:layout_height="wrap_content"
            android:text="@string/frag_tape_meas_input_label_3"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="textEnd"
            android:textColor="@color/off_white"/>

        <EditText
            android:id="@+id/etHips"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/textview_box"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp"
            android:gravity="center_vertical"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cmTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="cm"
            android:textStyle="bold"
            android:textAlignment="textEnd"
            android:textSize="20sp"
            android:textColor="@color/dark_brand_green"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/unitSwitch"
            android:layout_width="60dp"
            android:layout_height="37dp"
            android:textAlignment="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:paddingEnd="3dp"
            android:paddingStart="0dp"
            android:scaleX="1.5"
            android:scaleY="1.5" />

        <TextView
            android:id="@+id/inchTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="inch"
            android:textAlignment="textStart"
            android:textSize="20sp"
            android:textColor="@color/gray"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/frag_btn_cont"
        android:layout_marginTop="32dp"
        android:layout_gravity="center_horizontal"
        android:padding="12dp"
        android:paddingStart="35dp"
        android:paddingEnd="35dp"
        android:textSize="18sp"
        app:backgroundTint="@color/button_color"/>
</LinearLayout>